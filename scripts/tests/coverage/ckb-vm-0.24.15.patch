--- a/src/cov.rs
+++ b/src/cov.rs
@@ -0,0 +1,43 @@
+// Coverage instrumentation, never part of a node: appends "<program fnv64> <pc>" for every instruction the
+// asm machine decodes into a trace, once per process, to the file named by ICKB_COV_FILE.
+use std::cell::Cell;
+use std::collections::HashSet;
+use std::io::Write;
+use std::sync::{Mutex, OnceLock};
+
+thread_local! { static CUR: Cell<u64> = const { Cell::new(0) }; }
+type State = (HashSet<(u64, u64)>, Option<std::fs::File>);
+static SEEN: OnceLock<Mutex<State>> = OnceLock::new();
+
+pub fn set_program(bytes: &[u8]) {
+    let mut h: u64 = 0xcbf29ce484222325;
+    for b in bytes {
+        h ^= u64::from(*b);
+        h = h.wrapping_mul(0x100000001b3);
+    }
+    CUR.with(|c| c.set(h));
+}
+
+pub fn record(pcs: &[u64]) {
+    let id = CUR.with(|c| c.get());
+    let m = SEEN.get_or_init(|| {
+        let f = std::env::var("ICKB_COV_FILE").ok().map(|p| {
+            std::fs::OpenOptions::new().create(true).append(true).open(p).unwrap()
+        });
+        Mutex::new((HashSet::new(), f))
+    });
+    let mut g = m.lock().unwrap();
+    if g.1.is_none() {
+        return;
+    }
+    let mut out = String::new();
+    for &v in pcs {
+        // High byte carries the instruction length (fused instructions span several).
+        if g.0.insert((id, v)) {
+            out.push_str(&format!("{:x} {:x} {}\n", id, v & 0x00ff_ffff_ffff_ffff, v >> 56));
+        }
+    }
+    if !out.is_empty() {
+        g.1.as_mut().unwrap().write_all(out.as_bytes()).unwrap();
+    }
+}
